{
  "name": "support-chat-mvp",
  "version": "1.0.0",
  "description": "A lightweight Intercom-style support chat MVP with widget, agent inbox, realtime messaging, and SQLite storage.",
  "main": "server/index.js",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.cjs",
    "backup": "node scripts/backup.cjs",
    "check:launch": "node scripts/check-launch.cjs"
  },
  "dependencies": {
    "@whop/sdk": "^2.8.1",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^10.5.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "qs": "^6.17.1"
  },
  "engines": {
    "node": ">=22"
  }
}
