PORT=4000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
DATABASE_PATH=./support.sqlite
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-deploying
OWNER_EMAIL=danielkariuki3005@gmail.com
# Team AI keys are added by each workspace in Settings, not here.
# Generate a stable 32-byte hex encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this key up securely alongside database backups. Never rotate it without migrating saved credentials.
INTEGRATION_ENCRYPTION_KEY=
DISCORD_WEBHOOK_URL=

# Public application URL used in reset emails and checkout return links.
APP_URL=http://localhost:5173
# Optional proxy hop count; set only to match your deployment's trusted proxy chain.
TRUST_PROXY_HOPS=

# Outgoing password-reset mail. Use your provider's SMTP settings.
# Gmail: smtp.gmail.com, port 465, your sender address and a Google app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Whop: start in sandbox. Keep these server-side, never VITE_ variables.
WHOP_ENVIRONMENT=sandbox
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
WHOP_STARTER_PLAN_ID=
WHOP_GROWTH_PLAN_ID=
WHOP_PARTNER_PLAN_ID=
